<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bars</title>
    <script src="/webjars/tailwindcss__browser/dist/index.global.js"></script>
    <script src="/assets/index.js" defer></script>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
    <header class="fixed inset-x-0 top-0 z-10 border-b border-slate-200 bg-white shadow-sm">
        <nav class="mx-auto flex h-16 max-w-3xl items-center px-4 sm:px-6">
            <a class="text-xl font-semibold tracking-tight text-slate-900" href="/">Bars</a>
        </nav>
    </header>

    <main class="mx-auto max-w-3xl px-4 pb-12 pt-24 sm:px-6">
        <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <h1 class="text-2xl font-semibold tracking-tight">Bars</h1>
            <p class="mt-1 text-sm text-slate-500">Add a bar to the list.</p>

            <ul id="bars" class="mt-6 min-h-12 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-slate-50 px-4 [&>li]:py-3"></ul>

            <form id="form" class="mt-6 flex flex-col gap-3 sm:flex-row" action="/bars">
                <label class="sr-only" for="name">Bar name</label>
                <input id="name" class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-200" type="text" placeholder="Bar name" required>
                <button class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" type="submit">Add bar</button>
            </form>
        </section>
    </main>
</body>
</html>
